# Endereco base da API de CPF; a funcao tenta /api/cpf e depois /api/v2/generic/cpf.
CPF_API_BASE=https://snoopintelligence.cloud
CPF_API_TOKEN=seu_token_aqui

# Blackcat (gateway Pix) — pegue a API Key no painel administrativo da Blackcat.
BLACKCAT_API_KEY=sua_api_key_aqui
# Opcional: base da API (padrao: https://api.blackcatoficial.com/api)
# BLACKCAT_API_BASE=https://api.blackcatoficial.com/api